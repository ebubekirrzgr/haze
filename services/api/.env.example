# haze-api ortam değişkenleri (scripts/seed/keys.ts bu dosyayı üretebilir)
PORT=8787
DB_PATH=haze.db
PUBLIC_URL=http://localhost:8787
HAZE_CONFIG=../../testnet.contracts.json

# Stellar testnet gizli anahtarları (S...)
SPONSOR_SECRET=
OPERATOR_SECRET=
SETTLEMENT_SECRET=
TREASURY_SECRET=
ORACLE_ADMIN_SECRET=
BLEND_ADMIN_SECRET=
# treasury = distributor + market maker + Blend whale

# Lithic sandbox (boşsa haze-terminal ASA JSON'unu doğrudan /card/asa'ya gönderir)
LITHIC_API_KEY=
LITHIC_WEBHOOK_SECRET=
LITHIC_BASE_URL=https://sandbox.lithic.com/v1
VERIFY_ASA_HMAC=false

# Demo parametreleri
YIELD_DAYS_PER_MINUTE=1
HUSDY_APY=0.05
PRICE_INTERVAL_SEC=30
CREDIT_CACHE_SEC=10
